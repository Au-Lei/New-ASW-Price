ASW_DATA_DIR=data
ASW_LOG_DIR=logs
ASW_TIMEZONE=Asia/Shanghai
ASW_PORT=8000
ASW_UPLOAD_MAX_MB=20
ASW_UPLOAD_MAX_FILES=10
ASW_PDF_MAX_PAGES=50
ASW_HOST=127.0.0.1
ASW_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ASW_SESSION_HOURS=8
ASW_COOKIE_SECURE=false
# LAN: set ASW_HOST to the server private IPv4 and add that IP to ASW_ALLOWED_HOSTS.
# ASW_TLS_CERT=/absolute/path/server.crt
# ASW_TLS_KEY=/absolute/path/server.key
# DeepSeek: configure key locally with .venv/bin/python scripts/configure_ai.py
# Key lives in private .env.ai, never in frontend or Git.
ASW_AI_ENABLED=false
ASW_AI_MODEL=deepseek-flash
ASW_AI_TIMEOUT_SECONDS=90
ASW_AI_TOTAL_SECONDS=600
ASW_AI_MAX_CALLS=20

# Optional: keep localhost access when listening on an explicit LAN IP. One app instance.
ASW_LOOPBACK_ACCESS=false
